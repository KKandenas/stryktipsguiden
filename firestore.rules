rules_version = '2';

// Säkerhetsregler för Stryktipsguidens Firestore (Mina spel). Klistras in under Firestore → Regler i
// Firebase-konsolen (se FIREBASE.md). Principer:
// - Man läser och skriver bara sitt eget, utom spel som ägaren uttryckligen delat med ens e-postadress.
// - Delning kräver verifierad e-post (Google-konton och e-postlänkar är alltid verifierade).
// - Allt som skrivs kontrolleras: rätt ägare, 13 matcher, rimliga värden och högst 20 delningar.
// - Spelbolag: bara medlemmar ser bolaget. Man går med genom att ange bolagets inbjudningskod. Bara skaparen
//   ändrar inställningar och lägger till medlemmar utan konto; bara skaparen och kassören skriver i
//   kassaboken och ändrar vem som spelade ett spel.
service cloud.firestore {
  match /databases/{database}/documents {

    function inloggad() {
      return request.auth != null;
    }
    function minEpost() {
      return request.auth.token.email.lower();
    }
    function verifierad() {
      return inloggad() && request.auth.token.email_verified == true;
    }
    function giltigDelning(lista) {
      return lista is list && lista.size() <= 20;
    }
    // Profilbilden är en liten JPEG (data-URL, högst ~100 kB) eller Googles profilbild
    function giltigtBildvarde(b) {
      return b is string && b.size() <= 100000
        && (b.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+') || b.matches('https://lh[0-9]+[.]googleusercontent[.]com/.*'));
    }
    function giltigBild(d) {
      return !('bild' in d) || giltigtBildvarde(d.bild);
    }
    // En medlems post i spelbolaget: namn och eventuellt bild
    function giltigMedlemspost(p) {
      return p.keys().hasOnly(['namn', 'bild']) && p.namn is string && p.namn.size() <= 100 && giltigBild(p);
    }

    match /anvandare/{uid} {
      allow read: if inloggad() && request.auth.uid == uid;
      allow create, update: if inloggad() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['namn', 'epost', 'delad_med', 'skapad', 'bild'])
        && request.resource.data.namn is string && request.resource.data.namn.size() <= 100
        && giltigDelning(request.resource.data.delad_med)
        && giltigBild(request.resource.data);
      allow delete: if inloggad() && request.auth.uid == uid;
    }

    // ---------- spelbolag ----------

    function grupp(gid) {
      return get(/databases/$(database)/documents/grupper/$(gid)).data;
    }
    function medlemI(gid) {
      return inloggad() && request.auth.uid in grupp(gid).medlem_uids;
    }
    function bokforare(gid) {
      return inloggad() && (request.auth.uid == grupp(gid).skapare || request.auth.uid == grupp(gid).kassor);
    }
    function giltigtSpel(d) {
      return d.omgang_id is int && d.tecken is list && d.tecken.size() == 13
        && d.forslag_tecken is list && d.forslag_tecken.size() == 13
        && d.rader is int && d.rader >= 1 && d.rader <= 20000
        && (!('spelare' in d) || (d.spelare is string && d.spelare.size() <= 40));
    }

    match /inbjudningar/{kod} {
      // Bara den som känner koden kan läsa inbjudan; listning är avstängd
      allow get: if inloggad();
      allow list: if false;
      allow create: if inloggad()
        && getAfter(/databases/$(database)/documents/grupper/$(request.resource.data.gid)).data.skapare == request.auth.uid
        && getAfter(/databases/$(database)/documents/grupper/$(request.resource.data.gid)).data.kod == kod;
      allow delete: if inloggad() && grupp(resource.data.gid).skapare == request.auth.uid;
    }

    match /grupper/{gid} {
      allow read: if inloggad() && request.auth.uid in resource.data.medlem_uids;
      allow create: if inloggad()
        && request.resource.data.skapare == request.auth.uid
        && request.resource.data.medlem_uids == [request.auth.uid]
        && request.resource.data.namn is string && request.resource.data.namn.size() <= 60
        && request.resource.data.spelform in ['kassa', 'tur'];
      allow update: if inloggad() && (
        // Skaparen ändrar inställningar, medlemmar och kod (men kan inte lämna över skaparrollen)
        (resource.data.skapare == request.auth.uid
          && request.resource.data.skapare == resource.data.skapare
          && request.resource.data.medlem_uids.size() <= 20
          && (!('gaster' in request.resource.data) || request.resource.data.gaster.size() <= 40)
          && request.resource.data.spelform in ['kassa', 'tur'])
        // Gå med: ange rätt kod och lägg bara till sig själv
        || (!(request.auth.uid in resource.data.medlem_uids)
          && request.resource.data.anslut_kod == resource.data.kod
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['medlem_uids', 'medlemmar', 'turordning', 'anslut_kod'])
          && request.resource.data.medlem_uids == resource.data.medlem_uids.concat([request.auth.uid])
          && request.resource.data.medlemmar.diff(resource.data.medlemmar).affectedKeys().hasOnly([request.auth.uid])
          && giltigMedlemspost(request.resource.data.medlemmar[request.auth.uid])
          && request.resource.data.medlem_uids.size() <= 20)
        // Uppdatera sitt eget namn och sin bild i bolaget
        || (request.auth.uid in resource.data.medlem_uids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['medlemmar'])
          && request.resource.data.medlemmar.diff(resource.data.medlemmar).affectedKeys().hasOnly([request.auth.uid])
          && giltigMedlemspost(request.resource.data.medlemmar[request.auth.uid]))
        // Lämna: en medlem (inte skaparen) tar bort sig själv
        || (request.auth.uid in resource.data.medlem_uids
          && request.auth.uid != resource.data.skapare
          && !(request.auth.uid in request.resource.data.medlem_uids)
          && request.resource.data.medlem_uids.size() == resource.data.medlem_uids.size() - 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['medlem_uids', 'medlemmar', 'turordning']))
      );
      allow delete: if inloggad() && resource.data.skapare == request.auth.uid;

      match /spel/{omgang} {
        allow read: if medlemI(gid);
        allow create, update: if medlemI(gid)
          && request.resource.data.sparad_av == request.auth.uid
          && request.resource.data.grupp_id == gid
          && giltigtSpel(request.resource.data);
        // Skaparen och kassören kan ändra vem som spelade, även på spel som någon annan sparat
        allow update: if bokforare(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spelare', 'andrad'])
          && giltigtSpel(request.resource.data);
        allow delete: if medlemI(gid) && (resource.data.sparad_av == request.auth.uid || bokforare(gid));
      }

      match /kassabok/{post} {
        allow read: if medlemI(gid);
        allow create: if bokforare(gid)
          && request.resource.data.av == request.auth.uid
          && request.resource.data.typ in ['inbetalning', 'utbetalning', 'vinst', 'insats']
          && request.resource.data.belopp is number && request.resource.data.belopp > 0
          && request.resource.data.belopp <= 1000000;
        allow delete: if bokforare(gid);
      }
    }

    match /spel/{spelId} {
      allow read: if inloggad() && (resource.data.agare == request.auth.uid
        || (verifierad() && minEpost() in resource.data.delad_med));
      allow create, update: if inloggad()
        && request.resource.data.agare == request.auth.uid
        && spelId == request.auth.uid + '_' + string(request.resource.data.omgang_id)
        && request.resource.data.omgang_id is int
        && request.resource.data.tecken is list && request.resource.data.tecken.size() == 13
        && request.resource.data.forslag_tecken is list && request.resource.data.forslag_tecken.size() == 13
        && request.resource.data.rader is int && request.resource.data.rader >= 1 && request.resource.data.rader <= 20000
        && giltigDelning(request.resource.data.delad_med);
      allow delete: if inloggad() && resource.data.agare == request.auth.uid;
    }
  }
}
